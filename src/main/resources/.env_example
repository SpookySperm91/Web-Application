# Mongo Database
MONGO_DATABASE="databaseName"
MONGO_URI="uriLink"
MONGO_COLLECTION_USER="folder for user-data"
MONGO_COLLECTION_VERIFICATION_CODE="folder for verification-code"
MONGO_COLLECTION_VERIFICATION_LINK="folder for verification-link"
MONGO_COLLECTION_API_KEYS="folder for api-keys"

# SMTP email for sending messages
SPRING_MAIL_HOST="emailHost"
SPRING_MAIL_PORT="port"
SPRING_MAIL_USERNAME="emailAddress"
SPRING_MAIL_PASSWORD="password"
SMTP_AUTH="true"
SMTP_STARTTLS_ENABLE="true"

# Redis
SPRING_REDIS_HOST="localhost/host"
SPRING_REDIS_PORT="port"
SPRING_REDIS_PASSWORD="password"
SESSION_EXPIRATION_DEFAULT="default time expiration"

# URL link for external verification
LINK_CREATE_ACCOUNT=""
LINK_CHANGE_PASSWORD_PAGE=""

# Frontend port
FRONTEND_SERVER_PORT="8000"
FRONTEND_SERVER_BASE_URL="http://localhost:${env.FRONTEND_SERVER_PORT}"

# This system application port
SERVER_PORT="8080"
SERVER_BASE_URL="http://localhost:${env.SERVER_PORT}"

# CORS allowed configuration
CORS_ORIGINS="http://localhost:8000,http://localhost:3000"
CORS_METHODS="GET,POST,PUT,DELETE,OPTIONS"
CORS_HEADERS="*"